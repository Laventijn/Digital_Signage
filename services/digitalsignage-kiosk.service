[Unit]
Description=Digital Signage Chromium kiosk
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CONFIG_FILE=/etc/digitalsignage/digitalsignage.conf
ExecStart=/opt/digitalsignage/scripts/start-kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
